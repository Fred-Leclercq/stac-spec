{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.stacspec.org/v1.1.0/item-spec/json-schema/licensing.json",
  "title": "Licensing Fields",
  "type": "object",
  "properties": {
    "license": {
      "type": "string",
      "pattern": "^(\\(\\s*)*[\\w.\\-]+\\+?(\\s+WITH\\s+[\\w.\\-]+)?(((\\s*\\))+\\s*|\\s+)(AND|OR)(\\s*(\\(\\s*)+|\\s+)[\\w.\\-]+\\+?(\\s+WITH\\s+[\\w.\\-]+)?)*(\\s*\\))*$"
    }
  }
}